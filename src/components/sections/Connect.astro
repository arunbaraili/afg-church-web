---
import { content, directionsUrl } from '../../lib/content';
import SocialLinks from '../SocialLinks.astro';
import Arrow from '../Arrow.astro';
const { connect } = content;
---
<section class="connect-section section-space" id="connect" aria-labelledby="connect-heading"><div class="wrap"><div class="connect-grid"><div class="connect-copy"><h2 id="connect-heading">{connect.title}</h2><p class="lead">{connect.intro}</p><dl class="contact-details"><div><dt>Visit us</dt><dd>{connect.address}<br /><a class="link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions</a></dd></div><div><dt>Sunday gathering</dt><dd>{connect.serviceTime}</dd></div><div><dt>Let’s talk</dt><dd><a class="link" href={`mailto:${connect.email}`}>{connect.email}</a><br /><a class="link" href={`tel:${connect.phone.replace(/[^+\d]/g,'')}`}>{connect.phone}</a></dd></div></dl><SocialLinks /></div><form class="contact-form" action={connect.formAction} method="POST"><h3>{content.appearance.formHeading}</h3><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" maxlength="120" required /></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div class="field"><label for="message">How can we help?</label><textarea id="message" name="message" rows="5" maxlength="5000" required></textarea></div><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" /><p class="form-privacy">Your message goes to the church through Formspree. <a href="/privacy-policy/" class="link">Read our privacy policy.</a></p><button type="submit" class="btn">Send message <Arrow /></button><p class="form-status" role="status" aria-live="polite"></p></form></div><div class="map-container" data-map-url={connect.mapEmbededUrl} data-map-title={`Church location: ${connect.address}`}><div class="map-placeholder"><p>{content.appearance.mapHeading}</p><button class="text-link link" id="load-map" type="button">Load Google Map <Arrow /></button><small>Loading the map connects to Google Maps.</small><noscript><a href={directionsUrl}>Open directions in Google Maps</a></noscript></div></div></div></section>
<script>
  const form=document.querySelector<HTMLFormElement>('.contact-form');
  form?.addEventListener('submit',async e=>{
    e.preventDefault();
    const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status=form.querySelector<HTMLElement>('.form-status')!;
    if(button.disabled)return;
    const data=new FormData(form);
    if(String(data.get('_gotcha')||'').trim())return;
    button.disabled=true;button.setAttribute('aria-busy','true');status.textContent='Sending your message…';
    try {
      const response=await fetch(form.action,{method:'POST',body:data,headers:{Accept:'application/json'},signal:AbortSignal.timeout(20000)});
      if(!response.ok)throw new Error('Request failed');
      status.textContent='Your message has been sent. Thank you for connecting with us.';form.reset();
    }catch{status.textContent='Your message could not be sent. Please try again, or call or email the church. Your message is still here.';}
    finally{button.disabled=false;button.removeAttribute('aria-busy');}
  });
  document.querySelector('#load-map')?.addEventListener('click',()=>{
    const container=document.querySelector<HTMLElement>('.map-container')!;
    const iframe=document.createElement('iframe');iframe.src=container.dataset.mapUrl!;iframe.title=container.dataset.mapTitle || 'Church location';iframe.loading='lazy';iframe.referrerPolicy='strict-origin-when-cross-origin';iframe.sandbox.add('allow-scripts','allow-same-origin','allow-popups');iframe.allowFullscreen=true;container.replaceChildren(iframe);
  });
</script>
