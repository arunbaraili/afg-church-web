---
import { content } from '../lib/content';
interface Props { profiles?: { facebook?:string; instagram?:string; bible?:string }; personName?: string; }
const { profiles=content.settings.socials, personName } = Astro.props;
const links = [
  {key:'facebook', label:'Facebook', href:profiles.facebook},
  {key:'instagram', label:'Instagram', href:profiles.instagram},
  {key:'bible', label:'Read the Bible', href:profiles.bible},
];
---
{links.some(link=>link.href) && <nav class="social-links" aria-label={personName ? `${personName} social media` : "Social media and Bible"}>
  {links.filter(link=>link.href).map(link=><a class:list={['social-icon',link.key]} href={link.href} aria-label={personName ? `${personName} on ${link.label}` : link.label} target="_blank" rel="noopener noreferrer" title={link.label}>
    {link.key === 'facebook' ? <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 21v-8h2.8l.4-3H14V8.1c0-.9.3-1.6 1.6-1.6H17V3.8c-.3 0-1.3-.1-2.5-.1-2.6 0-4.3 1.5-4.3 4.4V10H8v3h2.2v8z"/></svg>
    : link.key === 'instagram' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
    : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 20h13V3H7a3 3 0 0 0-3 3v13a2 2 0 0 0 2 2m-2-3a2 2 0 0 1 2-2h13M11.5 6v7M9 8.5h5"/></svg>}
  </a>)}
</nav>}
